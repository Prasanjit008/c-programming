//To check whether an inputted number is an Armstrong number or not.
#include <stdio.h>
void main()
{
    int n, n1, rem, sum = 0;
    printf("Enter a number: ");
    scanf("%d", &n);
    n1=n;
    while(n!=0)
    {
        rem=n%10;
        sum=sum+rem*rem*rem;
        n=n/10;
    }
    if(n1 == sum)
        printf("The %d is an Armstrong number.\n", n1);
    else
        printf("The %d is not an Armstrong number.\n", n1);
}

