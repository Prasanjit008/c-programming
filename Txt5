//To find out the largest among 10 numbers
#include <stdio.h>
void main()
{
    int i, num, largest;
    printf("Enter 10 numbers:\n");
    scanf("%d", &largest);
    for(i = 2; i <= 10; i++)
    {
        scanf("%d", &num);
        largest = (num > largest) ? num : largest;
    }
    printf("Largest number = %d", largest);
}

