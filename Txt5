//To check whether an inputted number is a prime number or a composite number.
#include <stdio.h>
void main()
{
    int i, num, count=0;
    printf("Enter any number: ");
    scanf("%d", &num);
    for(i=1;i<=num;i++)
    {
        if(num%i==0)
            count+=1;
    }
    if(count==2)
        printf("%d is prime number.\n", num);
    else
        printf("%d is composite number.\n", num);
}

#pr7
//To check whether an inputted number is a palindrome number or not.
#include <stdio.h>
void main()
{
    int n, n1, rev=0, rem;
    printf("Enter a number: ");
    scanf("%d", &n);
    n1=n;
    while(n!=0)
    {
        rem= n%10;
        rev=(rev*10)+rem;
        n=n/10;
    }
    if(n1 == rev)
        printf("The %d is a palindrome.\n", n1);
    else
        printf("The %d is not a palindrome.\n", n1);
}

