//To convert a decimal number into binary.
#include <stdio.h>
void main()
{
    int n, rem, bin=0, place=1;
    printf("Enter a decimal number: ");
    scanf("%d", &n);
    while(n!=0)
    {
        rem=n%2;
        bin=bin+rem*place;
        n=n/2;
        place = place * 10;
    }
    printf("Binary equivalent = %d", bin);
}

#pr10
//To convert a binary number into decimal.
#include <stdio.h>
void main()
{
    int bin, dec=0, rem, base=1;
    printf("Enter a binary number: ");
    scanf("%d", &bin);
    while(bin!=0)
    {
        rem=bin%10;
        dec=dec+rem*base;
        bin=bin/ 10;
        base=base*2;
    }
    printf("Decimal equivalent = %d", dec);
}

